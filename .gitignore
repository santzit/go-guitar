# Godot 4+ specific ignores
.godot/
# But keep the extension list so the GDExtension loads without running the editor
!.godot/extension_list.cfg
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# GDExtension compiled libraries (build locally with: cd gp_extension && cargo build --release)
addons/gp_extension/bin/*.so
addons/gp_extension/bin/*.dll
addons/gp_extension/bin/*.dylib

# Rust build artefacts
gp_extension/target/
