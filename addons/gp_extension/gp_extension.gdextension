[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64   = "res://addons/gp_extension/bin/libgp_extension.so"
linux.release.x86_64 = "res://addons/gp_extension/bin/libgp_extension.so"
windows.debug.x86_64   = "res://addons/gp_extension/bin/gp_extension.dll"
windows.release.x86_64 = "res://addons/gp_extension/bin/gp_extension.dll"
