[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://addons/gp_extension/bin/libgp_extension.linux.x86_64.so"
linux.release.x86_64 = "res://addons/gp_extension/bin/libgp_extension.linux.x86_64.so"
windows.debug.x86_64 = "res://addons/gp_extension/bin/gp_extension.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/gp_extension/bin/gp_extension.windows.x86_64.dll"
macos.debug = "res://addons/gp_extension/bin/libgp_extension.macos.framework"
macos.release = "res://addons/gp_extension/bin/libgp_extension.macos.framework"
