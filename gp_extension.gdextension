[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
; Build with: cd gp_extension && cargo build --release
; Then copy the artefact to addons/gp_extension/bin/

linux.debug.x86_64     = "res://addons/gp_extension/bin/libgp_extension.so"
linux.release.x86_64   = "res://addons/gp_extension/bin/libgp_extension.so"
linux.debug.arm64      = "res://addons/gp_extension/bin/libgp_extension.arm64.so"
linux.release.arm64    = "res://addons/gp_extension/bin/libgp_extension.arm64.so"
windows.debug.x86_64   = "res://addons/gp_extension/bin/gp_extension.dll"
windows.release.x86_64 = "res://addons/gp_extension/bin/gp_extension.dll"
macos.debug            = "res://addons/gp_extension/bin/libgp_extension.dylib"
macos.release          = "res://addons/gp_extension/bin/libgp_extension.dylib"
